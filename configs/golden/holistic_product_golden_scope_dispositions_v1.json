      "gap_id": "HPG-GAP-REASSESS-001",
      "status": "RESOLVED_BY_PRODUCT_SCOPE",
      "decision": "Separate longitudinal Plan B/Plan C treatment-stage execution is outside holistic golden v1. The initial holistic semantic answer must include the source-backed dehydration classification, Plan B or Plan C, and the timed-reassessment instruction. A later full updated assessment may be submitted and evaluated afresh; EdgeIMCI v1 does not maintain treatment state, infer reassessment findings, or automatically repeat a rehydration plan.",
      "required_initial_semantics": [
        "DEHYDRATION_CLASSIFICATION",
        "PLAN_B_OR_PLAN_C_ACTION",
        "TIMED_REASSESSMENT_INSTRUCTION"
      ],
      "excluded_v1_behavior": [
        "LONGITUDINAL_TREATMENT_STATE",
        "AUTOMATIC_PLAN_REPETITION",
        "INFERRED_POST_REHYDRATION_FINDINGS",
        "DEDICATED_PLAN_B_OR_PLAN_C_TREATMENT_STAGE_ORACLE"
      ],
      "supporting_review_decision_ids": [
        "MSC-CQ-SCOPE-001",
        "MSC-CQ-REASSESS-001"
      ],
      "rationale_type": "PRODUCT_SCOPE_DECISION"
    }
  ]
