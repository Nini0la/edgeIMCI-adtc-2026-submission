      "kind": "respiratory_classification",
      "priority": 3,
      "source": {"section": "Cough or difficult breathing", "pdf_page": 6, "chart_page": "2 of 76"},
      "conditions": {"field": "respiratory.chest_indrawing", "equals": true},
      "result": {"classification": "PNEUMONIA", "actions": ["GIVE_ORAL_AMOXICILLIN_5_DAYS", "SOOTHE_THROAT_AND_RELIEVE_COUGH", "ADVISE_WHEN_TO_RETURN_IMMEDIATELY", "FOLLOW_UP_3_DAYS"]}
    },
    {
      "rule_id": "IMCI-RESP-PNEUMONIA-FAST-BREATHING",
      "kind": "respiratory_classification",
      "priority": 4,
      "source": {"section": "Cough or difficult breathing", "pdf_page": 6, "chart_page": "2 of 76"},
      "conditions": {"fast_breathing": true},
      "result": {"classification": "PNEUMONIA", "actions": ["GIVE_ORAL_AMOXICILLIN_5_DAYS", "SOOTHE_THROAT_AND_RELIEVE_COUGH", "ADVISE_WHEN_TO_RETURN_IMMEDIATELY", "FOLLOW_UP_3_DAYS"]}
    },
    {
      "rule_id": "IMCI-RESP-COUGH-OR-COLD",
      "kind": "respiratory_classification",
      "priority": 5,
      "source": {"section": "Cough or difficult breathing", "pdf_page": 6, "chart_page": "2 of 76"},
      "conditions": {"fallback": true},
      "result": {"classification": "COUGH_OR_COLD", "actions": ["SOOTHE_THROAT_AND_RELIEVE_COUGH", "ADVISE_WHEN_TO_RETURN_IMMEDIATELY", "FOLLOW_UP_5_DAYS_IF_NOT_IMPROVING"]}
    },
    {
      "rule_id": "IMCI-DIARRHOEA-SEVERE-DEHYDRATION",
      "kind": "dehydration_classification",
      "priority": 1,
      "source": {"section": "Diarrhoea — dehydration", "pdf_page": 7, "chart_page": "3 of 76"},
      "conditions": {"minimum_count": 2, "signs": [{"field": "danger_signs.lethargic_or_unconscious", "equals": true}, {"field": "dehydration.sunken_eyes", "equals": true}, {"field": "dehydration.drinking_status", "in": ["UNABLE", "POORLY"]}, {"field": "dehydration.skin_pinch", "equals": "VERY_SLOWLY"}]},
      "result": {"classification": "SEVERE_DEHYDRATION", "actions_without_other_severe_classification": ["GIVE_FLUID_FOR_SEVERE_DEHYDRATION_PLAN_C"], "actions_with_other_severe_classification": ["URGENT_REFERRAL", "FREQUENT_ORS_SIPS_DURING_REFERRAL", "CONTINUE_BREASTFEEDING"]}
    },
    {
      "rule_id": "IMCI-DIARRHOEA-SOME-DEHYDRATION",
      "kind": "dehydration_classification",
      "priority": 2,
      "source": {"section": "Diarrhoea — dehydration", "pdf_page": 7, "chart_page": "3 of 76"},
      "conditions": {"minimum_count": 2, "signs": [{"field": "dehydration.restless_or_irritable", "equals": true}, {"field": "dehydration.sunken_eyes", "equals": true}, {"field": "dehydration.drinking_status", "equals": "EAGER_OR_THIRSTY"}, {"field": "dehydration.skin_pinch", "equals": "SLOWLY"}]},
      "result": {"classification": "SOME_DEHYDRATION", "actions_without_other_severe_classification": ["GIVE_FLUID_ZINC_AND_FOOD_PLAN_B", "ADVISE_WHEN_TO_RETURN_IMMEDIATELY", "FOLLOW_UP_5_DAYS_IF_NOT_IMPROVING"], "actions_with_other_severe_classification": ["URGENT_REFERRAL", "FREQUENT_ORS_SIPS_DURING_REFERRAL", "CONTINUE_BREASTFEEDING"]}
    },
    {
      "rule_id": "IMCI-DIARRHOEA-NO-DEHYDRATION",
      "kind": "dehydration_classification",
      "priority": 3,
      "source": {"section": "Diarrhoea — dehydration", "pdf_page": 7, "chart_page": "3 of 76"},
      "conditions": {"fallback": true},
      "result": {"classification": "NO_DEHYDRATION", "actions": ["GIVE_FLUID_ZINC_AND_FOOD_PLAN_A", "ADVISE_WHEN_TO_RETURN_IMMEDIATELY", "FOLLOW_UP_5_DAYS_IF_NOT_IMPROVING"]}
    }
