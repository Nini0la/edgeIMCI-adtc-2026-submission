      "conditions": {"age_months": {"gte": 2, "lt": 12}, "respiratory_rate": {"gte": 50}},
      "result": {"fast_breathing": true}
    },
    {
      "rule_id": "IMCI-RESP-FAST-BREATHING-12-60M",
      "kind": "fast_breathing_threshold",
      "source": {"section": "Cough or difficult breathing", "pdf_page": 6, "chart_page": "2 of 76"},
      "conditions": {"age_months": {"gte": 12, "lt": 60}, "respiratory_rate": {"gte": 40}},
      "result": {"fast_breathing": true}
    },
    {
      "rule_id": "IMCI-RESP-SEVERE-DANGER-SIGN",
      "kind": "respiratory_classification",
      "priority": 1,
      "source": {"section": "Cough or difficult breathing", "pdf_page": 6, "chart_page": "2 of 76"},
      "conditions": {"any_general_danger_sign": true},
      "result": {"classification": "SEVERE_PNEUMONIA_OR_VERY_SEVERE_DISEASE", "actions": ["GIVE_FIRST_DOSE_APPROPRIATE_ANTIBIOTIC", "URGENT_REFERRAL"]}
    },
    {
      "rule_id": "IMCI-RESP-SEVERE-STRIDOR",
