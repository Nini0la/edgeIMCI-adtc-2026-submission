      "conditions": {"field": "danger_signs.convulsing_now", "equals": true},
      "result": {"danger_sign": "CONVULSING_NOW", "classification": "VERY_SEVERE_DISEASE", "actions": ["GIVE_DIAZEPAM_IF_CONVULSING_NOW", "COMPLETE_ASSESSMENT_QUICKLY", "GIVE_PRE_REFERRAL_TREATMENT_IMMEDIATELY", "PREVENT_LOW_BLOOD_SUGAR", "KEEP_WARM", "URGENT_REFERRAL"]}
    },
    {
