      "conditions": {"field": "danger_signs.unable_to_drink_or_breastfeed", "equals": true},
      "result": {"danger_sign": "UNABLE_TO_DRINK_OR_BREASTFEED", "classification": "VERY_SEVERE_DISEASE", "actions": ["COMPLETE_ASSESSMENT_QUICKLY", "GIVE_PRE_REFERRAL_TREATMENT_IMMEDIATELY", "PREVENT_LOW_BLOOD_SUGAR", "KEEP_WARM", "URGENT_REFERRAL"]}
    },
    {
      "rule_id": "IMCI-GDS-VOMITS-EVERYTHING",
