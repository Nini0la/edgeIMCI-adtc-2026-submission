      "conditions": {"field": "danger_signs.vomits_everything", "equals": true},
      "result": {"danger_sign": "VOMITS_EVERYTHING", "classification": "VERY_SEVERE_DISEASE", "actions": ["COMPLETE_ASSESSMENT_QUICKLY", "GIVE_PRE_REFERRAL_TREATMENT_IMMEDIATELY", "PREVENT_LOW_BLOOD_SUGAR", "KEEP_WARM", "URGENT_REFERRAL"]}
