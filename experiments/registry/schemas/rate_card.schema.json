{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeimci.local/schemas/rate-card-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rate_card_id", "version", "provider", "service", "currency", "effective_from", "region", "deployment", "pricing_mode", "rate_class", "unit_rates", "source"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "rate_card_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "service": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "region": {"type": ["string", "null"]},
    "deployment": {"type": ["string", "null"]},
    "pricing_mode": {"type": "string", "minLength": 1},
    "rate_class": {"enum": ["ESTIMATE_RATE", "ACTUAL_RATE"]},
    "unit_rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "unit", "price"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "unit": {"enum": ["PER_UNIT", "PER_1K", "PER_1M", "PER_SECOND"]},
          "price": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "retrieved_at", "verified"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "verified": {"type": "boolean"}
      }
    }
  }
}
