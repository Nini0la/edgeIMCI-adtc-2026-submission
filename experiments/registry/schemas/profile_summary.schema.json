{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeimci.local/schemas/profile-summary-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_summary_id", "experiment_id", "generated_at", "aggregation_method", "comparison_fingerprint", "measurement_mode", "included_runs", "excluded_runs", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_summary_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "aggregation_method": {"const": "edgeimci-profile-summary-v1"},
    "comparison_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "measurement_mode": {"enum": ["participant_laptop", "audit_cloud_vm"]},
    "included_runs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["run_id", "sidecar_path", "official_report_sha256"], "properties": {"run_id": {"type": "string"}, "sidecar_path": {"type": "string"}, "official_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
    },
    "excluded_runs": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["run_id", "reason"], "properties": {"run_id": {"type": "string"}, "reason": {"type": "string"}}}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(generation_tokens_per_second|first_token_latency_ms|peak_rss_mb|steady_state_rss_mb)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "mean", "median", "minimum", "maximum"],
          "properties": {"count": {"type": "integer", "minimum": 1}, "mean": {"type": "number"}, "median": {"type": "number"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}}
        }
      }
    }
  }
}
